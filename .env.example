# Server-side Gemini API Key (CRITICAL: NEVER use VITE_ prefix for server secrets. VITE_ variables are bundled into the client browser and exposed publicly).
GEMINI_API_KEY=

# App Authentication Token for server proxy security
APP_AUTH_TOKEN=

# Set to true only in local development if unauthenticated requests must be permitted for testing
ALLOW_INSECURE_DEV=false

# Optional AI API Base URL for proxy environments
VITE_AI_API_BASE_URL=
