# =====================================================================
# SECURITY WARNING: NEVER store server-side secrets with VITE_ prefix.
# VITE_* variables are bundled into the client browser and exposed publicly.
# =====================================================================

# Server-side Gemini API Key (Required for AI Proxy)
GEMINI_API_KEY=

# Authentication Secrets (JWT or Legacy Token)
APP_JWT_SECRET=
APP_AUTH_TOKEN=

# Set to true only in local development if unauthenticated requests must be permitted for testing
ALLOW_INSECURE_DEV=false

# Optional Public API Base URL
VITE_AI_API_BASE_URL=
