{
  "name": "thari-app",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "tsx scripts/run_regression_tests.ts && npx tsx scripts/run_security_tests.ts && npx jest --runInBand",
    "build:all": "vite build && cap sync",
    "build:android": "vite build && cap sync android",
    "build:ios": "vite build && cap sync ios",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "prepare:native:secure": "node ./scripts/prepare_native_secure.js || echo 'prepare script not available'"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "6.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "libphonenumber-js": "^1.13.12",
    "lucide-react": "^0.463.0",
    "motion": "^13.0.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^2.13.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.1",
    "sharp": "^0.35.3",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "overrides": {
    "tar": "^7.5.20",
    "sharp": "^0.35.3",
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "protobufjs@7.6.5": true,
    "sharp@0.35.3": true,
    "sharp@0.32.6": true
  }
}
